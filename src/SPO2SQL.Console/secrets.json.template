{
  "Application": {
    "Name": "SharePoint Sync Tool",
    "Version": "2.0.0",
    "LogLevel": "Debug",
    "EnableMetrics": true,
    "EnableHealthChecks": true,
    "Environment": "Development",
    "LegacyConfigPath": "XmlConfig\\UserConfig.xml"
  },
  "SharePoint": {
    "Username": "your-email@company.com",
    "Password": "your-password",
    "SiteUrl": "https://yourtenant.sharepoint.com",
    "TimeoutSeconds": 120,
    "MaxRetries": 3,
    "InitialRetryDelayMs": 1000
  },
  "Sql": {
    "ConnectionString": "Server=localhost;Database=SPO2SQL;Integrated Security=true;TrustServerCertificate=true;",
    "CommandTimeoutSeconds": 300,
    "BatchSize": 80,
    "EnforceEncryption": false
  }
}
